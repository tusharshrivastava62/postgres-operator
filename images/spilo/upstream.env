# The upstream Spilo release the images are built from, and this project's
# revision of the build. Read by .github/workflows/spilo-image.yml.
#
# SPILO_REF is a tag of https://github.com/zalando/spilo. SPILO_COMMIT is the
# commit that tag must point to: the workflow refuses to build if it does not,
# so a moved or re-created upstream tag cannot change what is built.
#
# IMAGE_REVISION is bumped to publish a rebuild of the same upstream release
# (to pick up operating system security updates, for example). Published tags
# are immutable and have the form <SPILO_REF>-r<IMAGE_REVISION>.
SPILO_REF=4.1-p2
SPILO_COMMIT=550c5d8c183340ccd98b19098f53f1261b71539a
IMAGE_REVISION=1
